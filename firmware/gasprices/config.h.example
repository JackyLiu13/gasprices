// Copy to config.h and fill in. config.h is gitignored — keep your WiFi
// password out of the repo.
#ifndef GP_CONFIG_H
#define GP_CONFIG_H

#define WIFI_SSID  "your-network"
#define WIFI_PASS  "your-password"

// Where build.py publishes. GitHub Pages (https://USER.github.io/gasprices/data.json)
// or raw.githubusercontent.com both work; Pages has friendlier caching.
#define DATA_URL   "https://YOURUSER.github.io/gasprices/data.json"

// --- Hardware ---------------------------------------------------------------
// Onboard 1.47" ST7789 LCD (172x320) on the Waveshare ESP32-C6-LCD-1.47. These
// are hardwired on the board, not free choices — none are broken out on the
// headers, which only expose GPIO 0-5, 9, 12, 13, 18, 19, 20, 23.
//
// On a different carrier board these will be wrong. `esptool` reports the chip,
// not the board, so read the silkscreen and the vendor's pinout before trusting
// any of this.
#define LCD_MOSI_PIN  6
#define LCD_SCLK_PIN  7
#define LCD_CS_PIN   14
#define LCD_DC_PIN   15
#define LCD_RST_PIN  21
#define LCD_BL_PIN   22   // backlight; driven high in uiBegin()

// 1 and 3 are the two landscape orientations (320x172). Flip to 3 if the screen
// reads upside down for how you have the board sitting. 0/2 give portrait, which
// the layout in ui.h is not designed for.
#define LCD_ROTATION  1

// BOOT button: press to cycle tank state FULL -> HALF -> LOW. Active low,
// internal pull-up. GPIO9 is a strapping pin, so if you want the button to also
// wake the board from deep sleep, move it to a free GPIO (e.g. 4).
#define TANK_BUTTON_PIN  9

// --- Power ------------------------------------------------------------------
// 0 = stay awake, refresh on a timer (use when USB-powered; screen stays live).
// 1 = deep sleep between refreshes (battery).
//
// Note the ST7789 behaves differently here from the SSD1306 this project
// originally targeted. The controller keeps its own GRAM through sleep, but the
// backlight is a plain GPIO, and GPIO22 is not an RTC pin on the C6 — so it
// drops on entry to deep sleep and the screen goes dark until the next wake.
// You get long battery life, not a persistent display.
#define USE_DEEP_SLEEP  0

// Local refresh times, 24 h. Ontario pump prices reset overnight and retailers
// often move again in the afternoon, so twice a day is plenty.
#define REFRESH_HOUR_AM  5
#define REFRESH_HOUR_PM  16
#define REFRESH_MINUTE   30

#define TZ_INFO  "EST5EDT,M3.2.0,M11.1.0"   // America/Toronto

#endif  // GP_CONFIG_H
